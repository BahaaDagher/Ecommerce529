@model Ecommerce529.ViewModels.OrderVM
@{
    ViewData["Title"] = "My Orders";
}

<div class="container-fluid py-5">
    <div class="container">

        @* Page Header *@
        <div class="d-flex align-items-center border-bottom pb-3 mb-4">
            <i class="fas fa-box-open text-primary fs-3 me-3"></i>
            <div>
                <h3 class="fw-bold mb-0">My Orders</h3>
                <small class="text-muted">Track and manage all your orders</small>
            </div>
        </div>

        @* Search Bar *@
        <form method="get" asp-action="Index" class="mb-4">
            <div class="input-group" style="max-width: 480px;">
                <input type="text"
                       name="carrierName"
                       value="@Context.Request.Query["carrierName"]"
                       class="form-control py-3 ps-4 rounded-pill rounded-end"
                       placeholder="Search by carrier name e.g. FedEx, DHL…" />
                <button type="submit" class="btn btn-primary rounded-pill rounded-start ms-2 px-4">
                    <i class="fas fa-search me-1"></i> Search
                </button>
                @if (!string.IsNullOrEmpty(Context.Request.Query["carrierName"]))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill ms-2 px-3">
                        <i class="fas fa-times me-1"></i> Clear
                    </a>
                }
            </div>
        </form>

        @* Orders Table *@
        @if (!Model.Orders.Any())
        {
            <div class="text-center py-5">
                <i class="fas fa-shopping-bag fa-4x text-muted mb-4" style="opacity:.3;"></i>
                <h5 class="fw-bold">No orders found</h5>
                <p class="text-muted">Try adjusting your search or place a new order.</p>
                <a href="/Customer/Home/Index" class="btn btn-primary rounded-pill px-4 mt-2">
                    <i class="fas fa-shopping-cart me-2"></i>Continue Shopping
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive rounded shadow-sm">
                <table class="table table-hover align-middle mb-0 bg-white">
                    <thead>
                        <tr style="background:#f1f8ff;">
                            <th class="ps-4 text-primary fw-semibold py-3">ORDER #</th>
                            <th class="text-primary fw-semibold py-3">DATE</th>
                            <th class="text-primary fw-semibold py-3">TOTAL</th>
                            <th class="text-primary fw-semibold py-3">ORDER STATUS</th>
                            <th class="text-primary fw-semibold py-3">PAYMENT</th>
                            <th class="text-primary fw-semibold py-3">CARRIER</th>
                            <th class="text-primary fw-semibold py-3">TRACKING</th>
                            <th class="pe-4"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model.Orders)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-secondary">#@order.Id</td>

                                <td class="text-muted small">
                                    @order.CreatedAt.ToString("MMM dd, yyyy")
                                </td>

                                <td class="fw-bold text-dark">$@order.TotalPrice.ToString("F2")</td>

                                @* Order Status Badge — inline styles for BS5.0 compatibility *@
                                <td>
                                    @{
                                        var (oBg, oColor) = order.OrderStatus switch
                                        {
                                            Ecommerce529.Models.OrderStatus.Pending => ("#fff3cd", "#856404"),
                                            Ecommerce529.Models.OrderStatus.InProgress => ("#cff4fc", "#055160"),
                                            Ecommerce529.Models.OrderStatus.Shipped => ("#cfe2ff", "#084298"),
                                            Ecommerce529.Models.OrderStatus.Completed => ("#d1e7dd", "#0a3622"),
                                            Ecommerce529.Models.OrderStatus.Canceled => ("#f8d7da", "#842029"),
                                            _ => ("#e2e3e5", "#41464b")
                                        };
                                    }
                                    <span class="badge rounded-pill px-3 py-2 fw-semibold"
                                          style="background-color:@oBg; color:@oColor;">
                                        @order.OrderStatus
                                    </span>
                                </td>

                                @* Payment Status Badge *@
                                <td>
                                    @{
                                        var (pBg, pColor) = order.PaymentStatus switch
                                        {
                                            Ecommerce529.Models.PaymentStatus.Completed => ("#d1e7dd", "#0a3622"),
                                            Ecommerce529.Models.PaymentStatus.Refuned => ("#f8d7da", "#842029"),
                                            _ => ("#fff3cd", "#856404")
                                        };
                                    }
                                    <span class="badge rounded-pill px-3 py-2 fw-semibold"
                                          style="background-color:@pBg; color:@pColor;">
                                        @order.PaymentStatus
                                    </span>
                                </td>

                                <td class="text-muted small">
                                    @(string.IsNullOrEmpty(order.CarrierName) ? "—" : order.CarrierName)
                                </td>

                                <td class="text-muted small">
                                    @(string.IsNullOrEmpty(order.TrackingId) ? "—" : order.TrackingId)
                                </td>

                                <td class="pe-4 text-end">
                                    <a asp-action="Details" asp-route-id="@order.Id"
                                       class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                        <i class="fas fa-eye me-1"></i> Details
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @* Pagination *@
            @if (Model.TotalPages > 1)
            {
                <div class="d-flex justify-content-center mt-4">
                    <nav aria-label="Orders pagination">
                        <ul class="pagination">
                            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@(Model.CurrentPage - 1)"
                                   asp-route-carrierName="@Context.Request.Query["carrierName"]">
                                    <i class="fas fa-angle-left"></i>
                                </a>
                            </li>

                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-page="@i"
                                       asp-route-carrierName="@Context.Request.Query["carrierName"]">
                                        @i
                                    </a>
                                </li>
                            }

                            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@(Model.CurrentPage + 1)"
                                   asp-route-carrierName="@Context.Request.Query["carrierName"]">
                                    <i class="fas fa-angle-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
                <p class="text-center text-muted small mt-1">Page @Model.CurrentPage of @Model.TotalPages</p>
            }
        }

    </div>
</div>

@model ProductVM
@{
    const int quantity = 500 ; 
}
<div class="container">
    <div class="row mb-3 align-items-center my-3">
        <div class="col-md-6">
            <h2 class="display-6">All Products</h2>
        </div>
        <div class="col-md-6 text-md-end text-start mt-2 mt-md-0">
            <a href="/Admin/Product/Create" class="btn btn-success">
                <i class="bi bi-plus-circle"></i>
                Create
                </a>
        </div>
    </div>
    @* filter section *@
    <form class="row g-3">
        <div class="col-4 mb-3">
            <label for="name" class="form-label">Name</label>
            <input class="form-control" name="productName" value="@ViewBag.ProductName" />
        </div>
        <div class="col-4 mb-3">
            <label for="MinPrice" class="form-label">Min Price</label>
            <input type="number" class="form-control" name="MinPrice" value="@ViewBag.MinPrice" />
        </div>
        <div class="col-4 mb-3">
            <label for="MaxPrice" class="form-label">MaxPrice</label>
            <input type="number"  class="form-control" name="MaxPrice" value="@ViewBag.MaxPrice" />
        </div>
        <div class="col-4 mb-3">
            <label for="CategoryId" class="form-label">Category Id</label>
            <input class="form-control" name="CategoryId" value="@ViewBag.CategoryId" />
        </div>
         <div class="col-4 mb-3">
            <label for="BrandId" class="form-label">Brand Id</label>
            <input class="form-control" name="BrandId" value="@ViewBag.BrandId" />
        </div>
        <div class="col-4 mb-3 d-flex justify-content-center align-items-center">
            <label for="name" class="form-label mx-3">IsLowQuantity</label>
            <input type="checkbox" class="" name="IsLowQuantity" value="True" />
        </div>
       
        <button type="submit" class="btn btn-dark col-2">Filter</button>
    </form>

    <div class="row">
        <div class="col-12">

            <table class="table table-hover">
                <thead>
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col">Name</th>
                        <th scope="col">Price</th>
                        <th scope="col">Quantity</th>
                        <th scope="col">Category Name</th>
                        <th scope="col">Brand Name</th>
                        <th scope="col">Status</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach(var item in Model.Products)
                    {
                        <tr>
                            <th scope="row">@item.Id</th>
                            <td>@item.Name</td>
                            <td>@item.Price</td>
                            <td>
                                @if (item.Quantity > quantity)
                                {
                                    <span class="badge text-bg-success">
                                        @item.Quantity
                                    </span>
                                }
                                else
                                {
                                    <span class="badge text-bg-danger">
                                        @item.Quantity
                                    </span>
                                }

                            </td>
                            <td>@item.Category.Name</td>
                            <td>@item.Brand.Name</td>
                            <td>
                                @if(item.Status)
                                {
                                    <span class="badge text-bg-success">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge text-bg-danger">
                                        In Active
                                    </span>
                                }

                            </td>
                            <td>
                                <a href="/Admin/Product/Edit/@item.Id"  type="button" class="btn btn-warning">
                                    <i class="bi bi-pencil"></i>
                                    Edit
                                </a>
                                <a href="/Admin/Product/Delete/@item.Id" class="btn btn-danger btn-delete">
                                    <i class="bi bi-trash3"></i>
                                    Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <nav aria-label="Page navigation example" >
        <ul class="pagination d-flex justify-content-center align-items-center ">
            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" href="/Admin/Product/Index?productName=@ViewBag.productName&page=@(Model.CurrentPage-1)" aria-label="Previous">
                    <span aria-hidden="true">&laquo;</span>
                </a>
            </li>
            @for(var i = 1 ; i <= Model.TotalPages; i++)
            {
                <li class="page-item"><a class="page-link @(Model.CurrentPage == i ? "active" : "")" href="/Admin/Product/Index?productName=@ViewBag.productName&page=@i">@i</a></li>
            }
            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                <a class="page-link" href="/Admin/Product/Index?productName=@ViewBag.productName&page=@(Model.CurrentPage+1)" aria-label="Next">
                    <span aria-hidden="true">&raquo;</span>
                </a>
            </li>
        </ul>
    </nav>
</div>


<script>
    document.addEventListener("DOMContentLoaded", function () {

        document.querySelectorAll(".btn-delete").forEach(button => {

            button.addEventListener("click", function (e) {
                e.preventDefault(); // stop default navigation

                const url = this.getAttribute("href");

                Swal.fire({
                    title: "Are you sure?",
                    text: "You won't be able to revert this!",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonColor: "#d33",
                    cancelButtonColor: "#6c757d",
                    confirmButtonText: "Yes, delete it!"
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = url; // continue delete
                    }
                });
            });

        });

    });
</script>